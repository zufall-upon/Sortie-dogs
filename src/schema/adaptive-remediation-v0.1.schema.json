{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zufall-upon/Sortie-dogs/schema/adaptive-remediation-v0.1.schema.json",
  "title": "Sortie-dogs Adaptive Remediation Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task_id", "selection", "state", "target", "allowed_paths", "limits", "probe_validation", "canonical_validation", "improvement_signals", "risk_class", "post_merge_validation", "baseline_probe", "iterations", "converged", "full_validation", "review", "promotion", "post_merge", "failure", "metrics"],
  "properties": {
    "version": { "const": "0.1.0" },
    "task_id": { "$ref": "#/$defs/id" },
    "selection": { "$ref": "#/$defs/selection" },
    "state": { "enum": ["ADMITTED", "PROBING", "PROMISING", "REFINING", "CONVERGED", "FULL_VALIDATED", "REVIEWED", "MERGED", "VERIFIED", "ABANDONED", "SOL_DEMOTED", "REJECTED", "REINTEGRATE_REQUIRED"] },
    "target": { "$ref": "#/$defs/target" },
    "allowed_paths": { "$ref": "#/$defs/scope" },
    "limits": { "$ref": "#/$defs/limits" },
    "probe_validation": { "$ref": "#/$defs/probeCommand" },
    "canonical_validation": { "$ref": "#/$defs/command" },
    "improvement_signals": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/signal" } },
    "risk_class": { "enum": ["low", "medium", "high"] },
    "post_merge_validation": { "$ref": "#/$defs/command" },
    "baseline_probe": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/baseline" }] },
    "iterations": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/iteration" } },
    "converged": { "type": "boolean" },
    "full_validation": { "$ref": "#/$defs/validation" },
    "review": { "$ref": "#/$defs/review" },
    "promotion": { "$ref": "#/$defs/promotion" },
    "post_merge": { "$ref": "#/$defs/validation" },
    "failure": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/failure" }] },
    "metrics": { "$ref": "#/$defs/metrics" }
  },
  "allOf": [
    { "if": { "properties": { "selection": { "type": "object", "properties": { "mode": { "const": "standard" } }, "required": ["mode"] } } }, "then": { "properties": { "iterations": { "type": "array", "maxItems": 0 }, "converged": { "const": false }, "state": { "const": "ADMITTED" } } } },
    { "if": { "properties": { "state": { "const": "VERIFIED" } }, "required": ["state"] }, "then": { "properties": { "converged": { "const": true }, "full_validation": { "type": "object", "properties": { "status": { "const": "pass" } }, "required": ["status"] }, "review": { "type": "object", "properties": { "status": { "const": "pass" } }, "required": ["status"] }, "promotion": { "type": "object", "properties": { "status": { "const": "promoted" } }, "required": ["status"] }, "post_merge": { "type": "object", "properties": { "status": { "const": "pass" } }, "required": ["status"] }, "failure": { "type": "null" } } } },
    { "if": { "properties": { "full_validation": { "type": "object", "properties": { "status": { "enum": ["pass", "fail"] } }, "required": ["status"] } } }, "then": { "properties": { "converged": { "const": true }, "metrics": { "type": "object", "properties": { "full_validation_count": { "const": 1 } }, "required": ["full_validation_count"] } } }, "else": { "properties": { "metrics": { "type": "object", "properties": { "full_validation_count": { "const": 0 } }, "required": ["full_validation_count"] } } } },
    { "if": { "properties": { "post_merge": { "type": "object", "properties": { "status": { "enum": ["pass", "fail"] } }, "required": ["status"] } } }, "then": { "properties": { "promotion": { "type": "object", "properties": { "status": { "const": "promoted" } }, "required": ["status"] }, "metrics": { "type": "object", "properties": { "post_merge_validation_count": { "const": 1 } }, "required": ["post_merge_validation_count"] } } }, "else": { "properties": { "metrics": { "type": "object", "properties": { "post_merge_validation_count": { "const": 0 } }, "required": ["post_merge_validation_count"] } } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "argv": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "command": { "type": "object", "additionalProperties": false, "required": ["executable", "timeout_ms"], "properties": { "executable": { "type": "string", "minLength": 1, "maxLength": 1000 }, "args": { "$ref": "#/$defs/argv" }, "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 1200000 } } },
    "probeCommand": { "type": "object", "additionalProperties": false, "required": ["executable", "timeout_ms", "observation_path"], "properties": { "executable": { "type": "string", "minLength": 1, "maxLength": 1000 }, "args": { "$ref": "#/$defs/argv" }, "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 1200000 }, "observation_path": { "$ref": "#/$defs/path" } } },
    "selection": { "type": "object", "additionalProperties": false, "required": ["mode", "reason", "activation_reason", "platform"], "properties": { "mode": { "enum": ["adaptive-remediation", "standard"] }, "reason": { "enum": ["eligible-auto", "unsupported-platform", "scope-ineligible", "validation-ineligible", "unsafe-target"] }, "activation_reason": { "type": "string", "minLength": 1, "maxLength": 256 }, "platform": { "enum": ["windows", "wsl"] } } },
    "target": { "type": "object", "additionalProperties": false, "required": ["ref", "base_head", "base_tree"], "properties": { "ref": { "type": "string", "minLength": 1, "maxLength": 256 }, "base_head": { "$ref": "#/$defs/sha" }, "base_tree": { "$ref": "#/$defs/sha" } } },
    "scope": { "type": "object", "additionalProperties": false, "required": ["read", "write"], "properties": { "read": { "type": "array", "uniqueItems": true, "maxItems": 256, "items": { "$ref": "#/$defs/path" } }, "write": { "type": "array", "uniqueItems": true, "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/path" } } } },
    "limits": { "type": "object", "additionalProperties": false, "required": ["iteration_budget", "max_changed_paths", "cleanup_timeout_ms"], "properties": { "iteration_budget": { "type": "integer", "minimum": 1, "maximum": 3 }, "max_changed_paths": { "type": "integer", "minimum": 1, "maximum": 256 }, "cleanup_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 } } },
    "signal": { "type": "object", "additionalProperties": false, "required": ["signal_id", "improvement_direction", "absolute_improvement_threshold", "goal"], "properties": { "signal_id": { "$ref": "#/$defs/id" }, "improvement_direction": { "enum": ["increase", "decrease"] }, "absolute_improvement_threshold": { "type": "number", "minimum": 0 }, "goal": { "type": "object", "additionalProperties": false, "required": ["operator", "value"], "properties": { "operator": { "enum": ["at-least", "at-most"] }, "value": { "type": "number" } } } } },
    "baseline": { "type": "object", "additionalProperties": false, "required": ["signal_id", "value", "artifact_fingerprint"], "properties": { "signal_id": { "$ref": "#/$defs/id" }, "value": { "type": ["number", "null"] }, "artifact_fingerprint": { "$ref": "#/$defs/fingerprint" } } },
    "validation": { "type": "object", "additionalProperties": false, "required": ["command", "status", "exit_code", "fingerprint"], "properties": { "command": { "type": "array", "minItems": 1, "maxItems": 129, "items": { "type": "string", "minLength": 1 } }, "status": { "enum": ["pending", "pass", "fail"] }, "exit_code": { "type": ["integer", "null"] }, "fingerprint": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/fingerprint" }] } } },
    "iteration": { "type": "object", "additionalProperties": false, "required": ["iteration", "parent_candidate", "candidate_head", "hypothesis", "patch_fingerprint", "changed_paths", "measured_probe", "cleanup"], "properties": { "iteration": { "type": "integer", "minimum": 1, "maximum": 3 }, "parent_candidate": { "$ref": "#/$defs/sha" }, "candidate_head": { "$ref": "#/$defs/sha" }, "hypothesis": { "type": "string", "minLength": 1, "maxLength": 1000 }, "patch_fingerprint": { "$ref": "#/$defs/fingerprint" }, "changed_paths": { "type": "array", "uniqueItems": true, "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/path" } }, "measured_probe": { "type": "object", "additionalProperties": false, "required": ["signal_id", "baseline_value", "current_value", "outcome", "artifact_fingerprint"], "properties": { "signal_id": { "$ref": "#/$defs/id" }, "baseline_value": { "type": ["number", "null"] }, "current_value": { "type": ["number", "null"] }, "outcome": { "enum": ["improved", "unchanged", "worse", "inconclusive"] }, "artifact_fingerprint": { "$ref": "#/$defs/fingerprint" } } }, "cleanup": { "type": "object", "additionalProperties": false, "required": ["status", "remaining_paths"], "properties": { "status": { "enum": ["pending", "pass", "fail"] }, "remaining_paths": { "type": "array", "uniqueItems": true, "maxItems": 256, "items": { "$ref": "#/$defs/path" } } } } } },
    "review": { "type": "object", "additionalProperties": false, "required": ["status", "fingerprint", "remediation_attempts"], "properties": { "status": { "enum": ["pending", "pass", "fail", "remediation-required"] }, "fingerprint": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/fingerprint" }] }, "remediation_attempts": { "type": "integer", "minimum": 0, "maximum": 1 } } },
    "promotion": { "type": "object", "additionalProperties": false, "required": ["status", "expected_target_head", "observed_target_head", "candidate_head"], "properties": { "status": { "enum": ["pending", "promoted", "cas-drift"] }, "expected_target_head": { "$ref": "#/$defs/sha" }, "observed_target_head": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha" }] }, "candidate_head": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha" }] } } },
    "failure": { "type": "object", "additionalProperties": false, "required": ["code", "fallback", "detail"], "properties": { "code": { "enum": ["PROBE_FAILED", "NO_IMPROVEMENT", "ITERATION_BUDGET_EXHAUSTED", "SCOPE_EXPANSION_REQUIRED", "CLEANUP_FAILED", "FULL_VALIDATION_FAILED", "REVIEW_REMEDIATION_REQUIRED", "CAS_DRIFT", "POST_MERGE_VERIFICATION_FAILED"] }, "fallback": { "enum": ["standard", "stop"] }, "detail": { "type": "string", "minLength": 1, "maxLength": 1000 } } },
    "metrics": { "type": "object", "additionalProperties": false, "required": ["mode", "reason", "activation_reason", "iteration_count", "probe_count", "full_validation_count", "post_merge_validation_count", "discarded_patch_count", "time_to_first_signal_ms", "duration_ms", "total_tokens", "estimated_cost_usd", "sol_demotions", "cas_conflicts", "post_merge_failures"], "properties": { "mode": { "enum": ["adaptive-remediation", "standard"] }, "reason": { "enum": ["eligible-auto", "unsupported-platform", "scope-ineligible", "validation-ineligible", "unsafe-target"] }, "activation_reason": { "type": "string", "minLength": 1 }, "iteration_count": { "type": "integer", "minimum": 0, "maximum": 3 }, "probe_count": { "type": "integer", "minimum": 0, "maximum": 4 }, "full_validation_count": { "type": "integer", "minimum": 0, "maximum": 1 }, "post_merge_validation_count": { "type": "integer", "minimum": 0, "maximum": 1 }, "discarded_patch_count": { "type": "integer", "minimum": 0, "maximum": 3 }, "time_to_first_signal_ms": { "type": ["integer", "null"], "minimum": 0 }, "duration_ms": { "type": "integer", "minimum": 0 }, "total_tokens": { "type": ["integer", "null"], "minimum": 0 }, "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 }, "sol_demotions": { "type": "integer", "minimum": 0 }, "cas_conflicts": { "type": "integer", "minimum": 0 }, "post_merge_failures": { "type": "integer", "minimum": 0 } } }
  }
}
